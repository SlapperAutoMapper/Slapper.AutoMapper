<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>Slapper.AutoMapper</PackageId>
        <Authors>Randy Burden &amp; contributors</Authors>
        <PackageProjectUrl>https://github.com/SlapperAutoMapper/Slapper.AutoMapper</PackageProjectUrl>
        <RepositoryUrl>https://github.com/SlapperAutoMapper/Slapper.AutoMapper</RepositoryUrl>
        <Version>3.0.0</Version>
        <TargetFrameworks>netstandard2.0;netstandard2.1;net47;net48;net6.0;net8.0;net9.0;net10.0</TargetFrameworks>
        <Product>Slapper.AutoMapper.Core</Product>
        <Copyright>Copyright (c) 2016, Randy Burden and contributors. All rights reserved.</Copyright>
        <Description>Slapper.AutoMapper is a mapping library that can convert dynamic data into static types and populate complex nested child objects.</Description>
        <PackageTags>Slapper.AutoMapper slapper automapper mapper map dynamic</PackageTags>
        <PackageReleaseNotes>Version 3.0.0 release
-Instance cache is now scoped to each mapping call (fixes #90, #81). keepCache is ignored; pass an InstanceCache to merge instances across calls.
-Added InstanceCache and overloads of Map/MapDynamic to share instances across calls explicitly. ClearInstanceCache is obsolete (no-op).
-Added targets netstandard2.0, net48, net6.0, net8.0, net9.0, net10.0</PackageReleaseNotes>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
      <None Include="..\LICENSE">
        <Pack>True</Pack>
        <PackagePath></PackagePath>
      </None>
    </ItemGroup>

</Project>
